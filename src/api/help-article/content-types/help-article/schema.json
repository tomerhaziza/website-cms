{
  "kind": "collectionType",
  "collectionName": "help_articles",
  "info": {
    "singularName": "help-article",
    "pluralName": "help-articles",
    "displayName": "Help Center Articles",
    "description": ""
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        },
        "translate": {
          "translate": "translate"
        }
      },
      "required": true
    },
    "slug": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "required": true
    },
    "helpCategory": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::help-category.help-category",
      "pluginOptions": {
        "translate": {
          "translate": "translate"
        }
      },
      "inversedBy": "helpArticles"
    },
    "paramsByRegulation": {
      "type": "component",
      "repeatable": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        },
        "translate": {
          "translate": "translate"
        }
      },
      "component": "brand-params.brand",
      "required": false
    },
    "content": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        },
        "translate": {
          "translate": "copy"
        }
      },
      "type": "customField",
      "options": {
        "output": "HTML",
        "preset": "rich"
      },
      "customField": "plugin::ckeditor.CKEditor",
      "required": false
    },
    "brand": {
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "type": "enumeration",
      "enum": [
        "all",
        "xtrade",
        "eightinvest"
      ],
      "default": "all"
    }
  }
}
